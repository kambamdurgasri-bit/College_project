# Supabase PostgreSQL Connection Pooler (IPv4 compatible for Render / cloud deployments)
# Host format: aws-0-[region].pooler.supabase.com (Region for this project: eu-north-1)
DATABASE_URL="postgresql://postgres.tqvafxpwqsnzwrlevjcb:learningtrackai123@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Direct URL used for Prisma migrations / push (Session pooler port 5432 supports direct connections)
DIRECT_URL="postgresql://postgres.tqvafxpwqsnzwrlevjcb:learningtrackai123@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret used to sign JWT auth tokens & HMAC OTP hashes:
JWT_SECRET="learntrack-ai-super-secret-jwt-key-2026-production"

# Port (default 5000)
PORT=5000

# Allowed Frontend Client URLs for CORS
CLIENT_URL="https://college-project-n8eb.vercel.app"

