# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL 14 or later.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Direct (non-pooled) connection used by `prisma db push`.
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign JWT auth tokens.
JWT_SECRET="replace-with-a-long-random-string"

# Port (default: 5000)
PORT=5000

# Allowed Frontend Client URLs for CORS (comma-separated, or * for all)
CLIENT_URL="https://your-frontend-domain.vercel.app"

# --- AI provider (required for quiz generation) ----------------------------
# OpenRouter is used as the primary provider. Without a key, quiz generation
# answers HTTP 503 instead of inventing questions.
OPENROUTERAI_API="sk-or-v1-replace-me"

# Optional overrides
# OPENROUTER_MODEL=google/gemini-3.8-flash
# GEMINI_API_KEY=
