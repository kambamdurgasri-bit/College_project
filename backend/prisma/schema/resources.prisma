// Study material a user attaches to a learning space (and optionally to one
// of its topics): uploaded PDFs / images, YouTube links, web links or typed
// notes. `extractedText` holds the PDF text that quiz generation feeds to the
// AI provider, so a quiz can be generated *from* a resource.
model Resources {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  learningSpaceId Int           @map("learning_space_id")
  topicId         Int?          @map("topic_id")
  title           String        @db.VarChar(200)
  type            String        @db.VarChar(20) // PDF | IMAGE | YOUTUBE | LINK | NOTE
  url             String?       @db.Text
  filePath        String?       @map("file_path") @db.VarChar(500)
  mimeType        String?       @map("mime_type") @db.VarChar(100)
  fileSize        Int?          @map("file_size")
  content         String?       @db.Text // typed notes
  extractedText   String?       @map("extracted_text") @db.Text // parsed PDF text for AI
  createdAt       DateTime      @default(now()) @map("created_at")
  user            Users         @relation(fields: [userId], references: [id])
  learningSpace   LearningSpaces @relation(fields: [learningSpaceId], references: [id])
  topic           Topics?       @relation(fields: [topicId], references: [id])
  quizzes         Quizzes[]

  @@index([learningSpaceId])
  @@index([topicId])
  @@index([userId])
  @@map("resources")
}
