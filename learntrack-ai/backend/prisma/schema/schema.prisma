// Shared Prisma config — do NOT put models here.
// Prisma 6 auto-merges every .prisma file in this folder when you run
// `npx prisma generate` or `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
