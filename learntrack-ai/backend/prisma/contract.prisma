// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Users {
  id              Int               @id(map: "users_pkey") @default(autoincrement())
  name            VarChar(100)
  email           VarChar(255)      @unique(map: "users_email_key")
  passwordHash    VarChar(255)      @map("password_hash")
  phoneNumber     VarChar(20)?      @map("phone_number")
  learningSpaces  LearningSpaces[]
  quizAttempts    QuizAttempts[]
  recommendations Recommendations[]
  timetables      Timetables[]

  @@map("users")
}

model LearningSpaces {
  id      Int          @id(map: "learning_spaces_pkey") @default(autoincrement())
  userId  Int          @map("user_id")
  name    VarChar(100)
  quizzes Quizzes[]
  user    Users        @relation(fields: [userId], references: [id], map: "learning_spaces_user_id_fkey")

  @@index([userId], map: "idx_learning_spaces_user_id")
  @@map("learning_spaces")
}

model Quizzes {
  id              Int            @id(map: "quizzes_pkey") @default(autoincrement())
  learningSpaceId Int            @map("learning_space_id")
  topic           VarChar(100)
  difficulty      VarChar(20)
  quizType        VarChar(20)    @default("TOPIC") @map("quiz_type")
  questions       Questions[]
  quizAttempts    QuizAttempts[]
  learningSpace   LearningSpaces @relation(fields: [learningSpaceId], references: [id], map: "quizzes_learning_space_id_fkey")

  @@index([learningSpaceId], map: "idx_quizzes_learning_space_id")
  @@check(expression: "((quiz_type)::text = ANY ((ARRAY['TOPIC'::character varying, 'PDF'::character varying])::text[]))", map: "quizzes_quiz_type_check")
  @@map("quizzes")
}

model Questions {
  questionId     Int              @id(map: "questions_pkey") @default(autoincrement()) @map("question_id")
  quizId         Int              @map("quiz_id")
  questionText   String           @map("question_text")
  correctAnswer  String           @map("correct_answer")
  attemptAnswers AttemptAnswers[]
  quiz           Quizzes          @relation(fields: [quizId], references: [id], map: "questions_quiz_id_fkey")

  @@index([quizId], map: "idx_questions_quiz_id")
  @@map("questions")
}

model QuizAttempts {
  quizAttemptId  Int                     @id(map: "quiz_attempts_pkey") @default(autoincrement()) @map("quiz_attempt_id")
  quizId         Int                     @map("quiz_id")
  userId         Int                     @map("user_id")
  attemptedAt    Timestamp               @map("attempted_at")
  score          Int
  attemptAnswers AttemptAnswers[]
  quiz           Quizzes                 @relation(fields: [quizId], references: [id], map: "quiz_attempts_quiz_id_fkey")
  user           Users                   @relation(fields: [userId], references: [id], map: "quiz_attempts_user_id_fkey")

  @@index([quizId], map: "idx_quiz_attempts_quiz_id")
  @@index([userId], map: "idx_quiz_attempts_user_id")
  @@map("quiz_attempts")
}

model AttemptAnswers {
  id             Int          @id(map: "attempt_answers_pkey") @default(autoincrement())
  quizAttemptId  Int          @map("quiz_attempt_id")
  questionId     Int          @map("question_id")
  selectedAnswer String       @map("selected_answer")
  question       Questions    @relation(fields: [questionId], references: [questionId], map: "attempt_answers_question_id_fkey")
  quizAttempt    QuizAttempts @relation(fields: [quizAttemptId], references: [quizAttemptId], map: "attempt_answers_quiz_attempt_id_fkey")

  @@unique([quizAttemptId, questionId], map: "uq_attempt_answers_attempt_question")
  @@index([questionId], map: "idx_attempt_answers_question_id")
  @@index([quizAttemptId], map: "idx_attempt_answers_quiz_attempt_id")
  @@map("attempt_answers")
}

model Recommendations {
  id                 Int         @id(map: "recommendations_pkey") @default(autoincrement())
  userId             Int         @map("user_id")
  recommendationType VarChar(50) @map("recommendation_type")
  recommendation     String
  createdAt          Timestamp   @default(now()) @map("created_at")
  user               Users       @relation(fields: [userId], references: [id], map: "recommendations_user_id_fkey")

  @@index([userId], map: "idx_recommendations_user_id")
  @@map("recommendations")
}

model Timetables {
  id        Int          @id(map: "timetables_pkey") @default(autoincrement())
  userId    Int          @map("user_id")
  day       VarChar(20)
  subject   VarChar(100)
  startTime Time         @map("start_time")
  endTime   Time         @map("end_time")
  user      Users        @relation(fields: [userId], references: [id], map: "timetables_user_id_fkey")

  @@index([userId], map: "idx_timetables_user_id")
  @@map("timetables")
}
